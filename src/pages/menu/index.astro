---
import Layout from '../../layouts/Layout.astro';
import { business as b } from '../../config/business';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tel = `tel:${b.phoneE164.replace(/-/g, '')}`;
---
<Layout path="menu/" title={`Menu & prices | ${b.name} (sample site)`} description="Regular and Cajun boiled peanuts by the quart, half-gallon and gallon tub, plus cold drinks and raw green peanuts. Sample site.">
    <!-- Price board -->
    <section id="prices" class="bg-pine text-paper">
      <div class="mx-auto max-w-6xl px-5 md:px-8 py-16 md:py-24 grid md:grid-cols-[1fr_1.6fr] gap-10 md:gap-16">
        <div class="reveal">
          <h1 class="font-display text-4xl md:text-5xl font-semibold leading-tight">The price board</h1>
          <p class="mt-4 text-paper text-lg leading-relaxed max-w-sm">Regular is salt and water, nothing else. Cajun gets red pepper, garlic and a slow burn that sneaks up on you.</p>
          <p class="mt-6 text-sm text-shell">{b.payment}</p>
        </div>
        <div class="reveal">
          <div class="grid grid-cols-[1fr_auto_auto] gap-x-5 md:gap-x-10 text-sm font-semibold text-shell pb-3">
            <span>Size</span><span class="w-14 text-right">Regular</span><span class="w-14 text-right">Cajun</span>
          </div>
          <ul>
            {b.prices.map((p) => (
              <li class="grid grid-cols-[1fr_auto_auto] gap-x-5 md:gap-x-10 items-baseline py-5 px-4 -mx-4 rounded-lg odd:bg-pine-soft">
                <span>
                  <span class="font-display text-2xl md:text-3xl">{p.size}</span>
                  <span class="block text-sm text-paper/65 mt-1">{p.note}</span>
                </span>
                <span class="w-14 text-right font-display text-2xl tabular-nums">${p.regular}</span>
                <span class="w-14 text-right font-display text-2xl tabular-nums text-shell">${p.cajun}</span>
              </li>
            ))}
          </ul>
          <ul class="mt-8 space-y-4">
            {b.extras.map((e) => (
              <li>
                <div class="flex items-baseline"><span class="font-semibold">{e.name}</span><span class="leader"></span><span class="font-display text-xl tabular-nums">${e.price}</span></div>
                <p class="text-sm text-paper/65">{e.note}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

</Layout>
